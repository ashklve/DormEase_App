{
  "expo": {
    "scheme": "dormease",
    "name": "DormEase",
    "slug": "DormEase_App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/spicon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDE8F0"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/spicon.png",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "DormEase uses your microphone to transcribe maintenance requests.",
        "NSPhotoLibraryUsageDescription": "DormEase needs photo library access to save QR codes and upload payment proofs.",
        "NSPhotoLibraryAddUsageDescription": "DormEase needs permission to save payment QR codes to your photo library.",
        "NSCameraUsageDescription": "DormEase needs camera access to take photos of maintenance issues.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.dormease.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/spicon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.ninerzaaa.dormease"
    },
    "web": {
      "favicon": "./assets/spicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#CA5D86",
          "defaultChannel": "default",
          "sounds": [
            "./assets/siren.wav"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "DormEase needs camera access to take photos of maintenance issues."
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FDE8F0",
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "DormEase uses your microphone to transcribe requests.",
          "speechRecognitionPermission": "DormEase uses speech recognition to convert your speech to text.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-sharing",
      "expo-audio"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4cf316c0-67bf-45fb-9cbf-16d9934c9b97"
      }
    },
    "owner": "uxplorers-01"
  }
}
