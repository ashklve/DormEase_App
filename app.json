{
  "expo": {
    "scheme": "dormease",
    "name": "DormEase_App",
    "slug": "DormEase_App",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "DormEase uses your microphone to transcribe maintenance requests.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.dormease.app"
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.ninerzaaa.dormease"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "react-native-vosk",
        {
          "models": [
            "assets/model-en-us",
            "assets/model-tl-ph"
          ],
          "iOSMicrophonePermission": "DormEase uses your microphone to transcribe maintenance requests."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "46e84472-1a36-4a48-b4ed-e9f9413b5b06"
      }
    }
  }
}